# Bash aliases — shared across all machines
# Machine-local aliases go in ~/.bash_aliases.local (not managed).

# General
{{- if ne .chezmoi.os "darwin" }}
alias bat=batcat           # Ubuntu packages bat as batcat
{{- end }}
alias ls='eza --icons --group-directories-first'
alias ll='eza -la --icons --group-directories-first --git'
alias lt='eza --tree --level=2 --icons'
alias search='rg'
alias lg='lazygit'

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tmux: attach-or-create main session
alias tm='tmux new -A -s main'

# Claude Code goes through workspaces when it's installed: allowed folders only, inside tmux,
# every launch logged. `command claude` goes around it.
if command -v workspaces >/dev/null 2>&1; then
{{- if eq .chezmoi.os "darwin" }}
  claude() { caffeinate -dis workspaces run . claude "$@"; }   # macOS: stay awake while it runs
{{- else }}
  claude() { workspaces run . claude "$@"; }
{{- end }}
fi

# Machine-local aliases (not managed by chezmoi)
[[ -f ~/.bash_aliases.local ]] && source ~/.bash_aliases.local
