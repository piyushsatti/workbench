diff --git a/scripts/restore.sh b/scripts/restore.sh
index 1a5e3f9..cce268a 100755
--- a/scripts/restore.sh
+++ b/scripts/restore.sh
@@ -29,9 +29,12 @@ is_line_type() {
 
 check_saved_session_exists() {
 	local resurrect_file="$(last_resurrect_file)"
-	if [ ! -f $resurrect_file ]; then
+	if [ ! -f "$resurrect_file" ]; then
 		display_message "Tmux resurrect file not found!"
 		return 1
+	elif [ ! -s "$resurrect_file" ]; then
+		display_message "Tmux resurrect file is empty: $resurrect_file"
+		return 1
 	fi
 }
 
@@ -178,6 +181,10 @@ restore_pane() {
 	while IFS=$d read line_type session_name window_number window_active window_flags pane_index pane_title dir pane_active pane_command pane_full_command; do
 		dir="$(remove_first_char "$dir")"
 		pane_full_command="$(remove_first_char "$pane_full_command")"
+		# Local patch: tmux format-expands -c and -T, and that expansion runs any #() it meets. A saved title can come from
+		# a program's terminal-title escape (Claude Code's topic titles included), so double each # to make both literal.
+		dir="${dir//\#/##}"
+		pane_title="${pane_title//\#/##}"
 		if [ "$session_name" == "0" ]; then
 			restored_session_0_true
 		fi
diff --git a/scripts/save.sh b/scripts/save.sh
index 01edcde..7f2fb71 100755
--- a/scripts/save.sh
+++ b/scripts/save.sh
@@ -244,7 +244,9 @@ save_all() {
 	dump_windows >> "$resurrect_file_path"
 	dump_state   >> "$resurrect_file_path"
 	execute_hook "post-save-layout" "$resurrect_file_path"
-	if files_differ "$resurrect_file_path" "$last_resurrect_file"; then
+	# A save racing a dying server dumps nothing; linking that empty file as
+	# `last` silently discards the only restore point. Drop it via the else branch.
+	if [ -s "$resurrect_file_path" ] && files_differ "$resurrect_file_path" "$last_resurrect_file"; then
 		ln -fs "$(basename "$resurrect_file_path")" "$last_resurrect_file"
 	else
 		rm "$resurrect_file_path"
