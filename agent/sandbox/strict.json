{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv"
      ],
      "denyWrite": [
        "./.git"
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(uv run ruff:*)",
      "Bash(uv run ty:*)",
      "Bash(uv run vulture:*)",
      "Bash(uv run xenon:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv lock:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git revert:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(git * add*)",
      "Bash(git * commit*)",
      "Bash(git * merge*)",
      "Bash(git * push*)",
      "Bash(git * rebase*)",
      "Bash(git * reset*)",
      "Edit(**/.env)",
      "Read(**/.env)"
    ]
  }
}
