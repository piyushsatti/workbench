{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "git *",
      "gh *"
    ],
    "filesystem": {
      "denyWrite": [
        "./.git/config",
        "./.git/hooks",
        "~/.gitconfig",
        "~/.config/git",
        "./.git/info"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(.venv/bin/pytest:*)",
      "WebSearch",
      "WebFetch",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(pwd)",
      "Bash(du:*)",
      "Bash(which:*)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git describe *)",
      "Bash(git shortlog *)",
      "Bash(git merge-base *)",
      "Bash(git cat-file *)",
      "Bash(git grep *)",
      "Bash(git name-rev *)",
      "Bash(git worktree list *)",
      "Bash(git stash list *)",
      "Bash(git remote -v)",
      "Bash(git remote get-url *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git tag -l *)",
      "Bash(git tag --list *)",
      "Bash(gh auth status)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue status *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh repo view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh search *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git apply *)",
      "Bash(git pull *)",
      "Bash(git stash push*)",
      "Bash(git stash pop*)",
      "Bash(git stash apply*)",
      "Bash(git stash)",
      "Bash(git worktree add *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git -C * stash *)",
      "Bash(git -C * merge *)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * reset *)",
      "Bash(git -C * checkout *)",
      "Bash(git -C * switch *)",
      "Bash(git -C * restore *)",
      "Bash(git -C * worktree add *)",
      "Bash(gh api *)",
      "Bash(curl *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(gh release create *)"
    ],
    "deny": [
      "Write(**/.git/**)",
      "Edit(**/.git/**)",
      "Bash(git * --output*)",
      "Bash(git push* --force*)",
      "Bash(git push* -f*)",
      "Bash(git push* --delete*)",
      "Bash(git push* -d*)",
      "Bash(git push* :*)",
      "Bash(git push* +*)",
      "Bash(git push* --mirror*)",
      "Bash(git push* --prune*)",
      "Bash(git branch* -D*)",
      "Bash(git branch* -d*)",
      "Bash(git branch* --delete*)",
      "Bash(git tag* -d*)",
      "Bash(git tag* --delete*)",
      "Bash(git reset* --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout* -- *)",
      "Bash(git checkout* -f*)",
      "Bash(git checkout* --force*)",
      "Bash(git checkout .)",
      "Bash(git switch* -f*)",
      "Bash(git switch* --force*)",
      "Bash(git switch* --discard-changes*)",
      "Bash(git restore .)",
      "Bash(git restore* -- *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git gc*)",
      "Bash(git prune*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git update-ref -d*)",
      "Bash(git update-ref --delete*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(gh * delete*)",
      "Bash(gh api* -X DELETE*)",
      "Bash(gh api* -XDELETE*)",
      "Bash(gh api* --method DELETE*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh auth logout*)",
      "Bash(git -c*)",
      "Bash(git * -c *)",
      "Bash(git --config-env*)",
      "Bash(git * --config-env*)",
      "Bash(git ls-remote* --upload-pack*)",
      "Bash(git ls-remote* -u*)",
      "Bash(git grep* -O*)",
      "Bash(git grep* --open-files-in-pager*)",
      "Bash(git * --ext-diff*)",
      "Bash(git * --textconv*)",
      "Bash(git * --exec*)",
      "Bash(git * --upload-pack*)",
      "Bash(git * --receive-pack*)",
      "Bash(git config*)",
      "Bash(git * config *)",
      "Bash(*GIT_*=*)",
      "Bash(env *)"
    ]
  }
}
