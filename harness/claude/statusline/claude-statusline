#!/usr/bin/env bash
# Claude Code status line, from workbench (harness/claude/statusline). Set it in ~/.claude/settings.json:
#   "statusLine": {"type": "command", "command": "$HOME/.local/bin/claude-statusline"}
# Claude Code pipes its status JSON here on each refresh. Before drawing, this keeps that JSON per session
# in $XDG_STATE_HOME/claude/statusline/<session id>.json (default ~/.local/state), with the reset times
# formatted locally, for the cc-status mod to draw the 5h and 7d limits in the prompt footer.
input=$(cat)

# ── Sidecar for the cc-status mod ─────────────────────────────────────
state=${XDG_STATE_HOME:-$HOME/.local/state}/claude
sid=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)
if [ -n "$sid" ]; then
  dir=$state/statusline
  mkdir -p "$dir" 2>/dev/null
  printf '%s' "$input" | jq -c '. + {
      local: {
        five_hour_reset: (.rate_limits.five_hour.resets_at // null | if . then strflocaltime("%H:%M") else null end),
        seven_day_reset: (.rate_limits.seven_day.resets_at // null | if . then strflocaltime("%a") else null end)
      }
    }' > "$dir/$sid.json.tmp" 2>/dev/null && mv -f "$dir/$sid.json.tmp" "$dir/$sid.json"
  find "$dir" -name '*.json' -mtime +3 -delete 2>/dev/null
fi

# BSD date (macOS) has no -d; GNU date has no -r or -j. Try both.
fmt_epoch() {
  date -r "$1" +"$2" 2>/dev/null || date -d "@$1" +"$2" 2>/dev/null
}

# ── Catppuccin Mocha palette ───────────────────────────────
# Primary (bold, high contrast)
lavender=$'\033[38;2;180;190;254m'  # #b4befe — folder

# Secondary (medium contrast)
subtext1=$'\033[38;2;186;194;222m'  # #bac2de — branch
teal=$'\033[38;2;148;226;213m'      # #94e2d5 — venv
sky=$'\033[38;2;137;220;235m'       # #89dceb — session name
sapphire=$'\033[38;2;116;199;236m'  # #74c7ec — ctx usage (normal)
flamingo=$'\033[38;2;242;205;205m'  # #f2cdcd — output style
blue=$'\033[38;2;137;180;250m'      # #89b4fa — effort level

# Accent
mauve=$'\033[38;2;203;166;247m'     # #cba6f7 — model
red=$'\033[38;2;243;139;168m'       # #f38ba8 — model when >200k / ctx when >80%
green=$'\033[38;2;166;227;161m'     # #a6e3a1 — rate limit low
yellow=$'\033[38;2;249;226;175m'    # #f9e2af — rate limit mid
peach=$'\033[38;2;250;179;135m'     # #fab387 — rate limit high

# Chrome
overlay0=$'\033[38;2;108;112;134m'  # #6c7086 — brackets / muted labels
bold=$'\033[1m'
reset=$'\033[0m'

# ── Extract fields ─────────────────────────────────────────
cwd=$(echo "$input" | jq -r '.cwd // empty')
exceeds_200k=$(echo "$input" | jq -r '.exceeds_200k_tokens // false')
rate_pct=$(echo "$input" | jq -r '.rate_limits.five_hour.used_percentage // empty')
rate_reset_5h=$(echo "$input" | jq -r '.rate_limits.five_hour.resets_at // empty')
weekly_pct=$(echo "$input" | jq -r '.rate_limits.seven_day.used_percentage // empty')
weekly_reset_7d=$(echo "$input" | jq -r '.rate_limits.seven_day.resets_at // empty')
thinking_enabled=$(echo "$input" | jq -r '.thinking.enabled // false')
ctx_used=$(echo "$input" | jq -r '.context_window.used_percentage // empty')
ctx_tokens=$(echo "$input" | jq -r '.context_window.total_input_tokens // empty')
ctx_size=$(echo "$input" | jq -r '.context_window.context_window_size // empty')
# Measure context against the autocompact window when one is set: that is the ceiling that
# triggers a compaction, not the model's full window. Only a positive integer counts, and only when it is
# below the model's window, which caps it.
compact_window=$(jq -r '.autoCompactWindow | select(type == "number" and . > 0 and . == floor and . < 1e15)' \
  "$HOME/.claude/settings.json" 2>/dev/null)
[[ $compact_window =~ ^[0-9]+$ ]] || compact_window=""
[[ $ctx_tokens =~ ^[0-9]+$ ]] || ctx_tokens=""
if [[ $ctx_size =~ ^[0-9]+$ ]] && [ -n "$compact_window" ] && [ "$compact_window" -ge "$ctx_size" ]; then
  compact_window=""
fi
if [ -n "$compact_window" ] && [ -n "$ctx_tokens" ]; then
  ctx_size="$compact_window"
  ctx_used=$((ctx_tokens * 100 / compact_window))
fi
output_style=$(echo "$input" | jq -r '.output_style.name // empty')
effort_raw=$(echo "$input" | jq -r '.effort.level // empty')
git_worktree=$(echo "$input" | jq -r '.workspace.git_worktree // empty')
agent_name=$(echo "$input" | jq -r '.agent.name // empty')

# Use harness model.id — updated immediately on /model switch
live_model_id=$(echo "$input" | jq -r '.model.id // empty')

model=""
if [ -n "$live_model_id" ]; then
  # The id goes in as an argument, never into the Python source.
  model=$(python3 - "$live_model_id" 2>/dev/null <<'PY'
import sys
mid = sys.argv[1]
for family in ('haiku', 'sonnet', 'opus', 'fable', 'mythos'):
    if family not in mid:
        continue
    suffix = mid.split(family + '-', 1)[1]
    suffix = suffix.split('[', 1)[0]
    parts = []
    for p in suffix.split('-'):
        if p.isdigit() and len(p) <= 2:
            parts.append(p)
        else:
            break
    version = '.'.join(parts) if parts else suffix.split('-')[0]
    print(family.capitalize() + ' ' + version)
    sys.exit(0)
print(mid)
PY
)
fi

# Fallback to harness display_name if model.id is missing or unparseable
if [ -z "$model" ]; then
  model_full=$(echo "$input" | jq -r '.model.display_name // empty')
  model="${model_full%% (*}"
fi

branch=""
[ -n "$cwd" ] && branch=$(git -C "$cwd" --no-optional-locks rev-parse --abbrev-ref HEAD 2>/dev/null)

# Linked-worktree fallback detection: in a git worktree, .git is a FILE (gitdir pointer)
[ -z "$git_worktree" ] && [ -n "$cwd" ] && [ -f "$cwd/.git" ] && git_worktree="wt"

# CWD tail: tilde-substitute $HOME prefix, then fish-style abbreviation
folder=""
if [ -n "$cwd" ]; then
  home_dir="${HOME:-/home/$(whoami)}"
  # Replace $HOME prefix with ~
  if [ "$cwd" = "$home_dir" ]; then
    display_cwd="~"
  elif [ "${cwd#"$home_dir/"}" != "$cwd" ]; then
    display_cwd="~/${cwd#"$home_dir/"}"
  else
    display_cwd="$cwd"
  fi

  # Fish-style abbreviation: last 2 components full, every middle component
  # shortened to its first char (dot-dirs keep dot + first char: .worktrees → .w)
  if [ "$display_cwd" = "~" ] || [ "$display_cwd" = "/" ]; then
    folder="$display_cwd"
  else
    if [ "${display_cwd#\~/}" != "$display_cwd" ]; then
      anchor="~"
      rel="${display_cwd#\~/}"
    else
      anchor=""
      rel="${display_cwd#/}"
    fi
    IFS='/' read -r -a _parts <<< "$rel"
    _n=${#_parts[@]}
    abbrev=""
    for ((_i = 0; _i < _n; _i++)); do
      comp="${_parts[_i]}"
      if [ "$_i" -ge $((_n - 2)) ] || [ -z "$comp" ]; then
        seg="$comp"
      elif [ "${comp#.}" != "$comp" ]; then
        seg="${comp:0:2}"
      else
        seg="${comp:0:1}"
      fi
      abbrev="${abbrev:+${abbrev}/}${seg}"
    done
    if [ -n "$anchor" ]; then
      folder="${anchor}/${abbrev}"
    else
      folder="/${abbrev}"
    fi
    [ -z "$abbrev" ] && folder="$display_cwd"
  fi
fi

# Model color: red when >200k, mauve otherwise
if [ "$exceeds_200k" = "true" ]; then
    model_color="${red}${bold}"
else
    model_color="${mauve}"
fi

# Rate limit color: green < 50, yellow < 75, peach < 90, red >= 90
rate_int=${rate_pct%.*}
rate_int=${rate_int:-0}
if [ "$rate_int" -ge 90 ]; then
    rate_color="${red}${bold}"
elif [ "$rate_int" -ge 75 ]; then
    rate_color="${peach}"
elif [ "$rate_int" -ge 50 ]; then
    rate_color="${yellow}"
else
    rate_color="${green}"
fi

# Context usage color: sapphire < 60, yellow 60-79, red ≥ 80
ctx_int=${ctx_used%.*}
ctx_int=${ctx_int:-0}
if [ -n "$ctx_used" ] && [ "$ctx_int" -ge 80 ]; then
    ctx_color="${red}${bold}"
elif [ -n "$ctx_used" ] && [ "$ctx_int" -ge 60 ]; then
    ctx_color="${yellow}"
else
    ctx_color="${sapphire}"
fi

# Effort: pass through whatever the harness reports — future-proof (new levels
# render without a code change; empty when the model has no effort support)
effort_label="$effort_raw"

# Output style: omit when it is the default
style_label=""
if [ -n "$output_style" ] && [ "$output_style" != "default" ] && [ "$output_style" != "Default" ]; then
  style_label="$output_style"
fi

# ── Line 1: folder  branch ─────────────────────────────────────────
line1="${lavender}${bold}${folder}${reset}"
if [ -n "$branch" ]; then
  branch_prefix=$' '                                # plain repo (Nerd Font branch U+E0A0)
  [ -n "$git_worktree" ] && branch_prefix=$' wt:'   # linked worktree
  line1="${line1} ${subtext1}${branch_prefix}${branch}${reset}"
fi

# ── Line 2: model 🧠/💤 effort [style] [agent] [ctx X%] ────────────
# "model 🧠 effort" is followed by spaces up to the longest ("Sonnet 5.5 🧠 medium", 20 columns, the emoji
# two), so the bar starts at the same column whichever model and effort are on.
line2="${model_color}${model}${reset}"
if [ "$thinking_enabled" = "true" ]; then
  line2="${line2} 🧠"
else
  line2="${line2} 💤"
fi
[ -n "$effort_label" ] && line2="${line2} ${blue}${effort_label}${reset}"
head_cols=$(( ${#model} + 3 + ${#effort_label} + (${#effort_label} > 0 ? 1 : 0) ))
(( head_cols < 20 )) && printf -v head_pad '%*s' $(( 20 - head_cols )) '' && line2="${line2}${head_pad}"
# The context as a bar of 20 cells over the window, all greys, in this order: the fixed load (system
# prompt, tool schemas, memory files, skills) mid-dark, the person's messages (I) lightest, the model's
# (O) mid, tool calls and results light, free (the auto-compact reserve included) dark. Neighbours
# alternate light and dark so the parts stay apart. The cc-status mod lays out the cells (f i o t .) at
# each turn's end; until it has, the percentage and token count as before.
g_fixed=$'\033[38;2;108;112;134m'    # #6c7086 overlay0
g_in=$'\033[38;2;205;214;244m'       # #cdd6f4 text
g_out=$'\033[38;2;147;153;178m'      # #9399b2 overlay2
g_tools=$'\033[38;2;186;194;222m'    # #bac2de subtext1
g_free=$'\033[38;2;49;50;68m'        # #313244 surface0
ctx_bar=""
ctx_file="${XDG_STATE_HOME:-$HOME/.local/state}/claude/statusline/$(echo "$input" | jq -r '.session_id // empty').ctx.json"
if [ -f "$ctx_file" ]; then
  ctx_cells=$(jq -r '.cells // empty' "$ctx_file" 2>/dev/null)
  for ((i = 0; i < ${#ctx_cells}; i++)); do
    case "${ctx_cells:i:1}" in
      f) ctx_bar+="${g_fixed}█" ;;
      i) ctx_bar+="${g_in}█" ;;
      o) ctx_bar+="${g_out}█" ;;
      t) ctx_bar+="${g_tools}█" ;;
      .) ctx_bar+="${g_free}█" ;;
    esac
  done
fi
if [ -n "$ctx_bar" ]; then
  line2="${line2} ${ctx_bar}${reset}"
elif [ -n "$ctx_used" ]; then
  ctx_seg="${overlay0}[${overlay0}ctx ${ctx_color}${ctx_int}%${overlay0}"
  # Current-context tokens vs window size (native fields; "lifetime" is not exposed)
  if [ -n "$ctx_tokens" ] && [ -n "$ctx_size" ]; then
    tok_lbl="$((ctx_tokens / 1000))k"
    if [ "$ctx_size" -ge 1000000 ]; then size_lbl="1M"; else size_lbl="$((ctx_size / 1000))k"; fi
    ctx_seg="${ctx_seg} ${subtext1}${tok_lbl}/${size_lbl}${overlay0}"
  fi
  line2="${line2} ${ctx_seg}]${reset}"
fi
# After the bar, so a style or an agent does not move it.
[ -n "$style_label" ]  && line2="${line2} ${overlay0}[${flamingo}${style_label}${overlay0}]${reset}"
[ -n "$agent_name" ]   && line2="${line2} ${overlay0}[${peach}${agent_name}${overlay0}]${reset}"

# ── Line 3: [5h X% → HH:MM] [7d Y% → Day] ───────────────────────────
weekly_int=${weekly_pct%.*}
weekly_int=${weekly_int:-0}
if [ "$weekly_int" -ge 90 ]; then
    weekly_color="${red}${bold}"
elif [ "$weekly_int" -ge 75 ]; then
    weekly_color="${peach}"
elif [ "$weekly_int" -ge 50 ]; then
    weekly_color="${yellow}"
else
    weekly_color="${green}"
fi

reset_5h_str=""
[ -n "$rate_reset_5h" ] && reset_5h_str=$(fmt_epoch "$rate_reset_5h" %H:%M)
reset_7d_str=""
[ -n "$weekly_reset_7d" ] && reset_7d_str=$(fmt_epoch "$weekly_reset_7d" %a)

line3=""
if [ -n "$rate_pct" ]; then
  seg="${overlay0}[${overlay0}5h ${rate_color}${rate_int}%${overlay0}"
  [ -n "$reset_5h_str" ] && seg="${seg} → ${subtext1}${reset_5h_str}${overlay0}"
  seg="${seg}]${reset}"
  line3="${seg}"
fi
if [ -n "$weekly_pct" ]; then
  seg="${overlay0}[${overlay0}7d ${weekly_color}${weekly_int}%${overlay0}"
  [ -n "$reset_7d_str" ] && seg="${seg} → ${subtext1}${reset_7d_str}${overlay0}"
  seg="${seg}]${reset}"
  [ -n "$line3" ] && line3="${line3} ${seg}" || line3="${seg}"
fi

# ── Cache state: Claude Code's own prompt_cache (warm, expires_at), so the 5-minute and 1-hour TTLs both read
# right. Claude Code also redraws the status line when expires_at passes. Older versions send no prompt_cache.
# `// ""` would turn warm=false into "", so null is mapped by hand. The separator is ',', not a tab: read
# collapses IFS whitespace, so a tab would let an empty warm take expires_at's value.
IFS=, read -r cache_warm cache_expires < <(echo "$input" | jq -r '.prompt_cache // {} | "\(.warm | if . == null then "" else tostring end),\(.expires_at // "")"')
if [ -n "$cache_warm" ]; then
  left=$(( ${cache_expires:-0} - $(date +%s) ))
  if [ "$cache_warm" = "true" ] && [ "$left" -gt 0 ]; then
    if [ "$left" -le 120 ]; then cache_color="${peach}"; else cache_color="${green}"; fi
    cache_seg="${overlay0}[cache ${cache_color}warm $(( (left + 59) / 60 ))m${overlay0}]${reset}"
  else
    cache_seg="${overlay0}[cache ${red}cold${overlay0}]${reset}"
  fi
  line2="${line2} ${cache_seg}"
fi

# ── observational-memory: its own segment, when it is installed ───────
if [ -x "$HOME/.local/bin/observational-memory" ]; then
  om=$(printf '%s' "$input" | "$HOME/.local/bin/observational-memory" statusline 2>/dev/null)
  [ -n "$om" ] && line2="${line2} ${overlay0}[${teal}${om}${overlay0}]${reset}"
fi

# ── Output ─────────────────────────────────────────────────────────────
# Line 3 (5h and 7d) is drawn at the right of the prompt footer by the cc-status mod, from the sidecar
# above. To draw it here again:
#   [ -n "$line3" ] && printf '%s\n' "$line3"
# %s, not %b: the colours are real escape bytes already, and the data (folder, branch, agent name) is printed as is.
printf '%s\n' "$line1" "$line2"
exit 0
